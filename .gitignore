# ========================================================
# 🧠 Root .gitignore for Django + Next.js monorepo
# ========================================================

# ------------------------------
# OS-specific files
# ------------------------------
.DS_Store
Thumbs.db

# ------------------------------
# Environment files
# ------------------------------
**/.env
**/.env.*
!.env.example
!Django-backend/.env.example
!.env.test

# ------------------------------
# Project folders
# ------------------------------
Kortex/
artifacts/
encryption_keys/
yaml/
/media/csv/**

# ------------------------------
# Python / Django
# ------------------------------
__pycache__/
*.py[cod]
*.pyc
*.log
*.pot
*.mo
*.so
db.sqlite3
scanner_logs.log

# Virtual environments
venv/
env/

# Migrations (ignore all but keep __init__.py)
**/migrations/
!**/migrations/__init__.py

# Celery
*.bak
*.dat
*.dir
django-backend/celerybeat-schedule

# Sphinx docs
docs/_build/

# C extensions
*.so

# Packaging
bin/
build/
develop-eggs/
eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------
# Node / Frontend
# ------------------------------
node_modules/
.pnp/
.pnp.js

# Build output
build/
dist/
.output
.vercel
.netlify
.wrangler

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------
# Frontend (Next.js in react-frontend/)
# ------------------------------
react-frontend/.next
react-frontend/out
react-frontend/node_modules

# Frontend logs
react-frontend/npm-debug.log*
react-frontend/yarn-debug.log*
react-frontend/yarn-error.log*

# Frontend env files
react-frontend/.env.local
react-frontend/.env.development.local
react-frontend/.env.test.local
react-frontend/.env.production.local

# Misc
react-frontend/.vercel
react-frontend/.DS_Store

# ------------------------------
# IDE / Editor Configs
# ------------------------------
.project
.pydevproject
.ropeproject
.mr.developer.cfg

# ------------------------------
# Logs directory
# ------------------------------
django-backend/logs/*.log
!django-backend/logs/.gitkeep

# ------------------------------
# Trained ML models
# ------------------------------
Django-backend/
# Explicitly ignore these heavy model folders (redundant but safe)
django-backend/guardrails_models/
django-backend/kamui_models/
django-backend/katana_models/
django-backend/models/

# ------------------------------
# Test & Coverage
# ------------------------------
coverage/
.tox/
.coverage
.cache
nosetests.xml
coverage.xml